<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>FF2 Analyzer</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<header class="topbar">
  <div class="brand">⚔ FF2 <span>ANALYZER</span></div>
  <nav>
    <button class="nav-btn active" data-view="home">Home</button>
    <button class="nav-btn" data-view="weapons">Weapons</button>
    <button class="nav-btn" data-view="bosses">Bosses</button>
    <button class="nav-btn" data-view="analyzer">Config Analyzer</button>
  </nav>
</header>

<main>
  <section id="home" class="view active">
    <div class="hero">
      <p class="eyebrow">TEAM FORTRESS 2 · FREAK FORTRESS 2</p>
      <h1>TF2 / FF2 <span>Analyzer</span></h1>
      <p>Explore weapons, FF2 attributes and bosses, or upload a configuration and inspect what it contains.</p>
      <div class="hero-actions">
        <button class="primary" data-view-link="analyzer">Analyze a CFG</button>
        <button class="secondary" data-view-link="weapons">Browse weapons</button>
        <button class="secondary" data-view-link="bosses">Browse bosses</button>
      </div>
    </div>
    <div class="cards">
      <article class="feature"><b>🔫 Weapons</b><span>TF2 weapon classnames, slots and attribute information.</span></article>
      <article class="feature"><b>👹 Bosses</b><span>A dedicated FF2 boss database ready for your server's roster.</span></article>
      <article class="feature"><b>📄 CFG Analyzer</b><span>Parse VDF/KeyValues-style FF2 configs directly in your browser.</span></article>
    </div>
  </section>

  <section id="weapons" class="view">
    <div class="section-head">
      <div><p class="eyebrow">DATABASE</p><h2>Weapons</h2></div>
      <input id="weapon-search" class="search" placeholder="Search weapons or classnames…">
    </div>
    <div id="weapon-list" class="grid"></div>
  </section>

  <section id="bosses" class="view">
    <div class="section-head">
      <div><p class="eyebrow">FREAK FORTRESS 2</p><h2>Bosses</h2></div>
      <input id="boss-search" class="search" placeholder="Search bosses…">
    </div>
    <div id="boss-list" class="grid"></div>
  </section>

  <section id="analyzer" class="view">
    <div class="section-head">
      <div><p class="eyebrow">LOCAL BROWSER PROCESSING</p><h2>Config Analyzer</h2></div>
    </div>
    <div id="dropzone" class="dropzone">
      <div class="drop-icon">📄</div>
      <h3>Drop an FF2 / TF2 .cfg here</h3>
      <p>Nothing is uploaded to a server. The file is parsed locally in your browser.</p>
      <label class="primary file-label">Choose CFG <input id="cfg-file" type="file" accept=".cfg,.txt"></label>
    </div>
    <div id="analysis-output" class="hidden"></div>
  </section>
</main>

<footer>FF2 Analyzer · Static GitHub Pages project · Customize the weapon and boss data in <code>/data</code>.</footer>
<script type="module" src="app.js"></script>
</body>
</html>